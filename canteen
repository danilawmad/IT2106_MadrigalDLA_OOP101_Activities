import java.util.Scanner;

public class Canteen {
    private static final String[] MENU_ITEMS = {
        "Lomi", "Tustado", "Guisado", "Magic Water", "Ice Cream"
    };

    private static final double[] MENU_PRICES = {
        80.00, 120.00, 100.00, 70.00, 90.00
    };

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        int totalQuantity = 0;
        double totalBeforeDiscount = 0.0;
        double totalDiscount = 0.0;
        boolean orderAgain = true;

        System.out.println("===== CANTEEN MENU =====");
        displayMenu();

        while (orderAgain) {
            System.out.print("\nEnter item number: ");
            int itemNumber = readInt(input);

            System.out.print("Enter quantity: ");
            int quantity = readInt(input);

            if (itemNumber < 1 || itemNumber > MENU_ITEMS.length
                    || quantity < 1 || quantity > 10) {

                System.out.println("\nInvalid order! Please enter a valid item and quantity.");
            } else {
                System.out.print("Are you a student? (Y/N): ");
                String studentAnswer = input.next().trim();
                boolean isStudent = studentAnswer.equalsIgnoreCase("Y");

                double subtotal = MENU_PRICES[itemNumber - 1] * quantity;
                double discountRate = getDiscountRate(isStudent, subtotal);
                double discount = subtotal * discountRate;
                double orderTotal = subtotal - discount;

                totalQuantity += quantity;
                totalBeforeDiscount += subtotal;
                totalDiscount += discount;

                System.out.printf("%nSubtotal: $%.2f%n", subtotal);
                System.out.printf("Discount: $%.2f%n", discount);
                System.out.printf("Order total: $%.2f%n", orderTotal);
            }

            System.out.print("\nDo you want to order again? (Y/N): ");
            orderAgain = input.next().trim().equalsIgnoreCase("Y");
        }

        double finalAmount = totalBeforeDiscount - totalDiscount;

        System.out.println("\n===== ORDER SUMMARY =====");
        System.out.println("Total items: " + totalQuantity);
        System.out.printf("Total before discount: $%.2f%n", totalBeforeDiscount);
        System.out.printf("Total discount: $%.2f%n", totalDiscount);
        System.out.printf("Final amount: $%.2f%n", finalAmount);
        System.out.println("Thank you for ordering!");

        input.close();
    }

    private static void displayMenu() {
        for (int index = 0; index < MENU_ITEMS.length; index++) {
            System.out.printf("%d. %-13s - $%.2f%n",
                    index + 1, MENU_ITEMS[index], MENU_PRICES[index]);
        }
    }

    private static double getDiscountRate(boolean isStudent, double subtotal) {
        if (isStudent && subtotal >= 500) {
            return 0.15;
        } else if (isStudent) {
            return 0.10;
        } else if (subtotal >= 500) {
            return 0.05;
        } else {
            return 0.0;
        }
    }

    private static int readInt(Scanner input) {
        while (!input.hasNextInt()) {
            System.out.print("Please enter a whole number: ");
            input.next();
        }

        return input.nextInt();
    }
}
